{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CipherRAGDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7254"
    ]
  },
  "Jwt": {
    "Key": "replace-with-a-long-random-secret-in-user-secrets-or-environment",
    "Issuer": "CipherRAG",
    "Audience": "CipherRAGUsers",
    "TokenExpirationInMinutes": "15"
  },
  "Presidio": {
    "ApiUrl": "http://localhost:5001"
  },
  "Guardrail": {
    "ApiUrl": "http://localhost:11434/api/generate",
    "Model": "llama-guard3:1b"
  },
  "LLM": {
    "OllamaEndpoint": "http://localhost:11434/api/generate",
    "Model": "llama3"
  },
  "AllowedHosts": "*"
}
